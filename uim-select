#!/usr/bin/python3

# ALERT!!! This script written by AI

import re
import subprocess
import time

DEVICE = "qrtr://0"
ATTEMPTS = 30
INTERVAL = 2
LAST_ERROR = ""

def qmi(*args):
    global LAST_ERROR

    try:
        result = subprocess.run(
            ["/usr/bin/qmicli", "-d", DEVICE, *args],
            capture_output=True,
            text=True,
            timeout=10,
        )
        if result.returncode != 0:
            LAST_ERROR = (result.stderr or result.stdout).strip()
        return result

    except (subprocess.TimeoutExpired, OSError) as exc:
        LAST_ERROR = str(exc)
        return None

def get_usims(output):
    """Return detected or ready USIM applications, sorted by slot."""
    result = []

    slots = re.split(r"(?m)^Slot \[(\d+)\]:", output)

    for i in range(1, len(slots), 2):
        slot = int(slots[i])
        data = slots[i + 1]

        if not re.search(r"Card state:\s*'present'", data):
            continue

        apps = re.split(
            r"(?m)^\s*Application \[(\d+)\]:",
            data,
        )

        for j in range(1, len(apps), 2):
            app_index = int(apps[j])
            app = apps[j + 1]

            if not re.search(
                r"Application type:\s*'usim\s*\(2\)'", app
            ):
                continue

            state_match = re.search(
                r"Application state:\s*'(detected|ready)'",
                app,
            )
            if not state_match:
                continue

            state = state_match.group(1)

            parts = app.split("Application ID:", 1)
            if len(parts) < 2:
                continue

            aid_text = parts[1].split(
                "Personalization state:", 1
            )[0]

            aid = "".join(
                re.findall(r"\b[0-9A-Fa-f]{2}\b", aid_text)
            ).upper()

            if len(aid) < 10 or len(aid) % 2:
                continue

            result.append((slot, app_index, aid, state))

    return sorted(result, key=lambda item: (item[0], item[1]))

def get_primary_session(output):
    match = re.search(
        r"Primary GW:\s*slot\s*'(\d+)',\s*application\s*'(\d+)'",
        output,
    )

    if match:
        return int(match.group(1)), int(match.group(2))

    return None

def main():
    print(f"Waiting for a usable USIM at {DEVICE}")

    for attempt in range(1, ATTEMPTS + 1):
        status = qmi("--uim-get-card-status")

        if status and status.returncode == 0:
            usims = get_usims(status.stdout)
            active = get_primary_session(status.stdout)

            if not usims:
                LAST_ERROR = (
                    "No USIM in detected/ready state with a valid AID."
                )
                print(
                    f"No usable USIM yet ({attempt}/{ATTEMPTS})."
                )

            else:
                slot, app_index, aid, app_state = usims[0]
                target = (slot, app_index)

                print(
                    f"USIM: slot {slot}, application {app_index}, "
                    f"state {app_state}, AID {aid}"
                )

                if active == target and app_state == "ready":
                    print("Correct USIM is already active.")
                    return 0

                if active == target:
                    print(
                        "Primary GW is selected; waiting for "
                        "the application to become ready."
                    )

                else:
                    if active is not None:
                        print(
                            f"Deactivating previous Primary GW "
                            f"session {active}."
                        )

                        deactivation = qmi(
                            "--uim-change-provisioning-session="
                            "activate=no,"
                            "session-type=primary-gw-provisioning"
                        )

                        if not deactivation or deactivation.returncode:
                            print("Could not deactivate previous session.")
                            if LAST_ERROR:
                                print(LAST_ERROR)
                            time.sleep(INTERVAL)
                            continue

                    print(
                        f"Activating USIM in slot {slot}, "
                        f"application {app_index}."
                    )

                    activation = qmi(
                        "--uim-change-provisioning-session="
                        "session-type=primary-gw-provisioning,"
                        f"activate=yes,slot={slot},aid={aid}"
                    )

                    if not activation or activation.returncode:
                        print("Activation failed; will retry.")
                        if LAST_ERROR:
                            print(LAST_ERROR)
                    else:
                        print("Activation command succeeded; verifying.")

        else:
            print(f"Modem not ready ({attempt}/{ATTEMPTS}).")

        # Verify activation on the next iteration instead of assuming
        # that a successful QMI command means the session is ready.
        if attempt < ATTEMPTS:
            time.sleep(INTERVAL)

    print("Timed out waiting for a ready, active USIM.")
    if LAST_ERROR:
        print(f"Last error: {LAST_ERROR}")
    return 1

if __name__ == "__main__":
    raise SystemExit(main())
